# Copy to .env.local (gitignored) for development; set the same variables on your host in production.

# The chat assistant (features.chat). https://console.anthropic.com — set a monthly spend limit too.
ANTHROPIC_API_KEY=

# Optional: raises GitHub's rate limit for the activity pane's repos call (features.githubActivity).
GITHUB_TOKEN=

# The deployed URL, for Open Graph and the sitemap. Vercel fills this in automatically.
NEXT_PUBLIC_SITE_URL=

# Optional: only for `npm run gaze` (the portrait following the cursor). About $0.12 per run.
REPLICATE_API_TOKEN=
